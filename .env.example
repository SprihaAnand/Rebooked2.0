# Copy this file to .env and replace every placeholder before deploying.
NODE_ENV=development
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/rebooked

# Used only to accept short-lived tokens from the legacy app during migration.
# Generate a high-entropy value; do not reuse this placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to make credentialed API requests.
CLIENT_URL=http://localhost:3000

# Google Identity Services client ID. No client secret is required for the
# server-side ID-token verification flow used by this application.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Mongo-backed browser session configuration.
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.org

# Run `npm run seed:admin` once after setting these values. Admin accounts are
# intentionally not creatable through the public registration endpoint.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Rebooked Administrator
